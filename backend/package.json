{
  "name": "mc-estetica-backend",
  "version": "1.0.0",
  "description": "Backend API para o Sistema MC Estética & Bem-Estar (Dra. Márcia Cristina)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "test:rbac": "ts-node src/tests/rbac.test.ts",
    "test:cpf": "ts-node src/tests/cpfValidation.test.ts",
    "test": "npm run test:rbac && npm run test:cpf",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/uuid": "^9.0.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
